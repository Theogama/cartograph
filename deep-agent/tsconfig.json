{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../lib/agent/analysis-credential.ts",
    "../lib/agent/repository-tools.ts",
    "../lib/graph-maths.ts",
    "../lib/repository-parser.ts"
  ]
}
